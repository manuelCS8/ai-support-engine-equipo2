HOST=127.0.0.1
PORT=3000
# Obtén tu clave en https://aistudio.google.com/api-keys
# Guarda la clave sólo en .env, nunca en archivos públicos o en GitHub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=60000
