{
  "name": "ai-support-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Prototipo de soporte con reglas, Machine Learning (sklearn) e IA generativa (Gemini)",
  "engines": { "node": ">=22.9" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test tests/*.test.cjs",
    "compare": "node --env-file-if-exists=.env scripts/compare.js",
    "ml:train": "python scripts/train_ml.py",
    "ml:predict": "python scripts/predict_ml.py"
  }
}
